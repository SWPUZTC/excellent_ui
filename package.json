{
    "name": "excellent_ui",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "prettier": "prettier --write \"{packages, docs}/**/*.{js,jsx,ts,tsx,css,scss,md}\"",
        "eslint": "eslint \"{packages, docs}/**/*.{js,jsx,ts,tsx}\" --fix --cache",
        "stylelint": "stylelint \"{packages, docs}/**/*.{css,scss,sass}\" --fix --cache",
        "prepare": "husky",
        "commit": "git-cz",
        "doc:dev": "cd docs && pnpm dev",
        "test": "cd packages/components && pnpm test",
        "build": "cd packages/components && pnpm build"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "config": {
        "commitizen": {
            "path": "node_modules/cz-git"
        }
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@eslint/js": "^9.39.1",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.6",
        "@types/react-dom": "^19.2.3",
        "commitlint": "^20.1.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-vitest": "^0.5.4",
        "git-cz": "^4.9.0",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.6",
        "prettier": "^3.6.2",
        "stylelint": "^16.25.0",
        "stylelint-config-standard": "^39.0.1",
        "stylelint-scss": "^6.12.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.47.0"
    },
    "lint-staged": {
        "*.{md,json}": [
            "prettier --cache --write --no-error-on-unmatched-pattern"
        ],
        "*.{css,scss,sass}": [
            "stylelint --fix",
            "prettier --cache --write"
        ],
        "*.{js,jsx}": [
            "eslint --fix",
            "prettier --cache --write"
        ],
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --cache --parser=typescript --write"
        ]
    },
    "dependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    }
}
