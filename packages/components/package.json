{
    "name": "@excellent-ui/components",
    "version": "1.0.0",
    "description": "核心组件库",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsup --metafile",
        "dev": "tsup --watch",
        "test": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./index.css": "./dist/index.css"
    },
    "sideEffects": [
        "**/*.css",
        "**/*.scss"
    ],
    "dependencies": {
        "@excellent-ui/hooks": "workspace:*",
        "@excellent-ui/themes": "workspace:*",
        "@excellent-ui/utils": "workspace:*",
        "lodash": "^4.17.21",
        "@arco-design/web-react": "^2.66.8"
    },
    "keywords": [
        "react",
        "components"
    ],
    "author": "",
    "license": "ISC",
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/lodash": "^4.17.21",
        "@types/react": ">=18",
        "@types/react-dom": ">=18",
        "@vitejs/plugin-react": "^5.1.1",
        "autoprefixer": "^10.4.22",
        "classnames": "^2.5.1",
        "cssnano": "^7.1.2",
        "esbuild-plugin-sass": "^1.0.1",
        "jsdom": "^27.2.0",
        "postcss": "^8.5.6",
        "tsup": "^8.5.1",
        "vitest": "^4.0.10"
    }
}
